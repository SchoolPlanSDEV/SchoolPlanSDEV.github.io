rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ["YOUR_ADMIN_AUTH_UID"];
    }

    // Timetable is readable by visitors; only the configured admin can edit it.
    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Keep future personal/student records private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}